# Copy to .env and fill in. Dummy values are fine for a first boot — nothing
# calls LINE/WhatsApp/Claude until a real webhook or message arrives, but
# every var below is read eagerly at startup (`std::env::var(...)?`), so
# main() will exit immediately if any are missing.

# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgres://bizbrain:bizbrain@localhost:5432/bizbrain

# HS256 signing secret for the Owner's JWT cookie (T05). Any string works
# for local testing; use a real random secret before deploying.
JWT_SECRET=dev-only-change-me

# LINE Messaging API (R01/T04). From the LINE Developers Console.
LINE_CHANNEL_SECRET=dev-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=dev-line-channel-access-token

# WhatsApp Business Cloud API (R02/T04). From the Meta App dashboard.
WHATSAPP_VERIFY_TOKEN=dev-whatsapp-verify-token
WHATSAPP_ACCESS_TOKEN=dev-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=0000000000000

# Used by agent::ClaudeClassifier's fallback classify call (T03).
ANTHROPIC_API_KEY=sk-ant-your-key-here
