# Copy to .env and fill in real values before deploying.
# Dummy values are safe for first boot — nothing calls external APIs
# until a real webhook arrives, but every var marked (required) is read
# eagerly at startup and will cause main() to exit if missing.

# ── Database (required) ───────────────────────────────────────────────── #
# Matches docker-compose.yml's postgres service for local dev.
DATABASE_URL=postgres://bizbrain:bizbrain@localhost:5432/bizbrain

# ── Auth (required) ───────────────────────────────────────────────────── #
# HS256 signing secret for the Owner JWT cookie. Use a real random value
# before deploying (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-only-change-me

# ── Server (optional, defaults shown) ────────────────────────────────── #
# P08: Railway injects PORT automatically. Set locally if 8080 is taken.
PORT=8080
# P08: path to the web/static directory (relative to the binary cwd).
# Set to web/static on Railway via the env panel.
STATIC_DIR=web/static

# ── LINE Messaging API (required for LINE) ────────────────────────────── #
LINE_CHANNEL_SECRET=dev-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=dev-line-channel-access-token

# ── WhatsApp Business Cloud (required for WhatsApp) ───────────────────── #
WHATSAPP_VERIFY_TOKEN=dev-whatsapp-verify-token
WHATSAPP_ACCESS_TOKEN=dev-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=0000000000000

# ── Telegram (required for Telegram) ─────────────────────────────────── #
TELEGRAM_SECRET_TOKEN=dev-telegram-secret
TELEGRAM_BOT_TOKEN=0000000000:dev-bot-token
# P11: set to your Railway public URL to auto-register the webhook on startup.
# e.g. https://biz-brain-production.up.railway.app/webhooks/telegram
# Leave unset to skip auto-registration (register manually via /admin endpoint).
# TELEGRAM_WEBHOOK_URL=https://your-app.up.railway.app/webhooks/telegram

# ── Claude (required for agent) ──────────────────────────────────────── #
ANTHROPIC_API_KEY=sk-ant-your-key-here